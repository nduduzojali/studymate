# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to GitHub — it is already in .gitignore.

# Your MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/studymate?retryWrites=true&w=majority

# Any long random string — used to sign JWT login tokens
JWT_SECRET=replace-this-with-a-long-random-string

# Port the server listens on (Render sets this automatically in production)
PORT=5000
